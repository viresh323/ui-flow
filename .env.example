# Provider selection. One env var switches the whole system.
AI_PROVIDER=gemini
AI_MODEL=                     # blank = per-provider default; set it if the default is not available to your key
AI_MAX_RPM=15                 # free-tier Gemini is ~15 req/min

GOOGLE_API_KEY=

# Target
TARGET_BASE_URL=http://localhost:8080
TENANT_ID=local
TENANT_PARABANK_OPERATOR_USER=john
TENANT_PARABANK_OPERATOR_PASSWORD=demo

# Run behaviour
MAX_STEPS=25
STEP_TIMEOUT_MS=15000
HEADLESS=false
LOG_LEVEL=info
RUNS_DIR=runs
CHECKPOINT_DB=runs/checkpoints.sqlite

# Headroom prompt compression (degrades to uncompressed if the proxy is absent)
HEADROOM_ENABLED=true
HEADROOM_AUTOSTART=true
HEADROOM_BASE_URL=
HEADROOM_MODE=token
HEADROOM_MIN_PROMPT_CHARS=8000
