{
  "kind": "capability",
  "schemaVersion": "1.0.0",
  "id": "read_account_balance",
  "version": "1.0.0",
  "name": "Read account balance",
  "description": "Signs in as the configured operator and returns the current balance for a given account number from the Accounts Overview screen. Read-only.",
  "surface": "web",
  "app": {
    "product": "parabank",
    "productVersionRange": "*",
    "entryPoint": {
      "path": "/parabank/index.htm",
      "requiresSession": true
    }
  },
  "contract": {
    "inputs": [
      {
        "name": "account_id",
        "description": "The account number to read",
        "type": {
          "kind": "account_number"
        },
        "required": true,
        "sensitivity": "pii"
      }
    ],
    "outputs": [
      {
        "name": "balance",
        "description": "Current balance",
        "type": {
          "kind": "money",
          "currency": "USD"
        },
        "sensitivity": "pii",
        "fromBinding": "balance_text",
        "transforms": [
          {
            "op": "trim"
          },
          {
            "op": "strip_currency"
          },
          {
            "op": "to_number"
          }
        ],
        "required": true
      }
    ],
    "outcomes": [
      {
        "code": "LOGIN_FAILED",
        "description": "Operator credentials rejected by the application.",
        "detect": {
          "assert": "text_matches",
          "pattern": "could not be verified",
          "flags": "i"
        },
        "outputs": [],
        "terminal": true,
        "appliesTo": [
          "submit_login"
        ]
      },
      {
        "code": "ACCOUNT_NOT_FOUND",
        "description": "The requested account is not visible to this operator. A legitimate answer, not a failure.",
        "detect": {
          "assert": "not",
          "of": {
            "assert": "element_present",
            "locator": {
              "id": "balance_cell",
              "describe": "Balance column for the requested account in the Accounts Overview grid",
              "region": {
                "framePath": []
              },
              "candidates": [
                {
                  "candidate": {
                    "using": "table_cell",
                    "rowMatch": {
                      "columnHeader": "Account",
                      "equals": "${account_id}"
                    },
                    "columnHeader": "Balance"
                  },
                  "confidence": 0.9,
                  "rationale": "Header-relative intersection; independent of row order, paging and column count."
                },
                {
                  "candidate": {
                    "using": "near_anchor",
                    "anchorText": "${account_id}",
                    "targetRole": "cell"
                  },
                  "confidence": 0.55
                }
              ],
              "match": {
                "requireUnique": true,
                "minConfidence": 0.4,
                "onMultiple": "fail"
              }
            }
          }
        },
        "outputs": [],
        "terminal": true,
        "appliesTo": [
          "read_balance"
        ]
      }
    ]
